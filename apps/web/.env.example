# Vorlage — nach .env.local kopieren und ausfüllen.
#
# Ohne diese Variablen läuft die App weiter, sie nutzt dann die Mock-Daten
# aus src/lib/mock-data.ts (siehe src/lib/supabase.ts).
#
# Lokale Entwicklung: Werte kommen aus `npx supabase start` im Repo-Root.
# Die Ports sind bewusst 553xx statt der Supabase-Standardports 543xx, weil
# auf dem Entwicklungsrechner ein zweites, fremdes Supabase-Projekt läuft
# (siehe supabase/config.toml).
#
# Beide Werte sind ÖFFENTLICH (NEXT_PUBLIC_) und landen im Browser-Bundle.
# Das ist so vorgesehen: geschützt wird über Row Level Security, nicht über
# Geheimhaltung des Keys. Der service_role-Key gehört NIEMALS hierher.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
